# Copy to .env in services/api. No DB is required for /health.
# Local PostgreSQL (docker compose up -d db):
DATABASE_URL=postgresql+psycopg://optimesh:optimesh@127.0.0.1:5432/optimesh
# Hosted: paste the Supabase session-pooler URI, use the psycopg dialect and TLS.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
# For certificate validation: sslmode=verify-full&sslrootcert=/path/to/supabase-ca.crt
# Migrations may use a separate privileged direct/session URI:
# MIGRATION_DATABASE_URL=...
CORS_ORIGINS=["http://localhost:3000"]
# MQTT broker (docker compose up -d mqtt). Leave unset to run without MQTT.
MQTT_HOST=127.0.0.1
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Public Supabase project URL for bearer-token verification on the /sites routes.
# /api/v1 does not check tokens yet (issue #3).
# Configure asymmetric ES256 or RS256 signing keys in Supabase Auth.
# No service-role key or JWT signing secret is required.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
