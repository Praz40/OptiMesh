# Copy to .env in services/api. No DB is required for /health.
# Local PostgreSQL (docker compose up -d db):
DATABASE_URL=postgresql+psycopg://optimesh:optimesh@127.0.0.1:5432/optimesh
# Hosted: paste the Supabase session-pooler URI, use the psycopg dialect and TLS.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
# For certificate validation: sslmode=verify-full&sslrootcert=/path/to/supabase-ca.crt
# Migrations may use a separate privileged direct/session URI:
# MIGRATION_DATABASE_URL=...
CORS_ORIGINS=["http://localhost:3000"]
# MQTT broker (docker compose up -d mqtt). Leave unset to run without MQTT.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Explicit anonymous loopback simulator broker only; real brokers require TLS.
MQTT_TLS=false
# MQTT_USERNAME=
# MQTT_PASSWORD=
# TLS (e.g. the Raspberry Pi Mosquitto on 8883). The broker certificate and the MQTT_HOST name
# are always verified; MQTT_HOST must match the certificate's DNS name or IP (SAN).
# MQTT_TLS=true
# MQTT_PORT=8883
# Public CA that signed the real broker certificate (PEM).
# MQTT_CA_FILE=/path/to/broker-ca.crt

# Public Supabase project URL for bearer-token verification on the /sites routes.
# /api/v1 does not check tokens yet (issue #3).
# Configure asymmetric ES256 or RS256 signing keys in Supabase Auth.
# No service-role key or JWT signing secret is required.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Real Pi broker: replace the loopback settings above. TLS never falls back to plaintext.
# MQTT_HOST=192.168.0.23
# MQTT_PORT=8883
# MQTT_TLS=true
# MQTT_CA_FILE=C:/path/outside/repository/mosquitto-ca.crt
# MQTT_CA_CERT is also accepted for existing Pi configurations.
# MQTT_USERNAME=optimesh-backend
# MQTT_PASSWORD=YOUR_BACKEND_PASSWORD
# MQTT_CLIENT_ID=optimesh-backend-demo
# Optional exact device scope; ack subscription uses the same site's/device's ack topic.
# MQTT_TELEMETRY_TOPIC=optimesh/v1/sites/SITE_UUID/devices/DEVICE_UUID/telemetry
# Keep backend credentials separate from device credentials and never commit secrets.
