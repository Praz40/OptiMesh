{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "command_id",
    "site_id",
    "device_id",
    "issued_at",
    "expires_at",
    "command",
    "params"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string",
      "enum": [
        "set_enabled"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "$comment": "Consumers MUST assert uuid and date-time formats during validation; Draft 2020-12 format annotations alone do not validate these values. See docs/contracts.md for validation and runtime requirements."
}
