{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandAcknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "command_id",
    "site_id",
    "device_id",
    "observed_at",
    "status",
    "error_code",
    "state"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "rejected",
        "failed"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "expired",
        "invalid_payload",
        "unsupported_command",
        "out_of_range",
        "interlock",
        "hardware_failure",
        null
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "$comment": "Consumers MUST assert uuid and date-time formats during validation; Draft 2020-12 format annotations alone do not validate these values. See docs/contracts.md for validation and runtime requirements.",
  "description": "Acknowledgement for the current set_enabled-only MVP. Adding another command requires reviewing the applied state requirement.",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "applied"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "null"
          },
          "state": {
            "required": [
              "enabled"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "error_code": {
            "type": "string"
          }
        }
      }
    }
  ]
}
