{
  "$defs": {
    "DeviceState": {
      "additionalProperties": false,
      "description": "Controllable state as the device actually applied it.",
      "properties": {
        "on": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On"
        },
        "setpoint_w": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setpoint W"
        }
      },
      "title": "DeviceState",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "description": "Power sign convention depends on the device kind; see docs/contracts.md.",
      "properties": {
        "power_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power W"
        },
        "energy_wh": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy Wh"
        },
        "soc_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Soc Pct"
        },
        "voltage_v": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voltage V"
        },
        "current_a": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current A"
        }
      },
      "title": "Metrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "site_id": {
      "format": "uuid",
      "title": "Site Id",
      "type": "string"
    },
    "device_id": {
      "format": "uuid",
      "title": "Device Id",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "version",
    "site_id",
    "device_id",
    "message_id",
    "observed_at",
    "metrics"
  ],
  "title": "Telemetry",
  "type": "object"
}
